# deploy.sh が @USER@ / @DIR@ / @NODE@ / @DATA_DIR@ を埋めてから /etc/systemd/system に置く
[Unit]
Description=Data Counter (pachislot external terminal logger)
After=network-online.target
Wants=network-online.target
# データベースを外付けのディスクに置いたとき、マウントされるまで起動を待つ
RequiresMountsFor=@DATA_DIR@
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-@DIR@/.env
Environment=NODE_ENV=production
ExecStart=@NODE@ --enable-source-maps @DIR@/apps/server/dist/index.mjs
Restart=always
RestartSec=5

# 書き込めるのはデータベースの置き場所だけにする
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target

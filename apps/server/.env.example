# このファイルを .env にコピーして使う（.env はコミットしない）

# 待ち受けるアドレスとポート。Pico から LAN 経由で届くように 0.0.0.0 にしておく
HOST=0.0.0.0
PORT=3012

# Pico からの送信に必要なトークン。空にすると誰でも送れる
# 生成例: openssl rand -hex 24
INGEST_TOKEN=

# 実戦を自動で始めるときの機種（machines/ のファイル名から .json を除いたもの）
DEFAULT_MACHINE=discup2

# 省略するとリポジトリの中の data/, machines/, apps/web/dist/client を使う
# DATA_DIR=./data
# MACHINES_DIR=./machines
# WEB_DIR=./apps/web/dist/client

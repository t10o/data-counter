{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "maker": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "debounceMs": {
      "default": 10,
      "description": "チャタリングとみなして無視する時間（ミリ秒）。これより短いパルスは捨てる。IN / OUT のパルスを消さないよう 50 未満にする（目安は 10）",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 50
    },
    "gameGapMs": {
      "default": 1000,
      "description": "IN のパルスがこれだけあいたら次のゲームとみなす（ミリ秒）。レバーオンで出るパルスの塊を 1 ゲームと数えるので、ベット枚数が変わっても数えられる",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pins": {
      "default": {},
      "type": "object",
      "properties": {
        "in": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "out": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "label": {
            "description": "種別が決まるまでの表示名。省略時は種別名を / でつなぐ",
            "type": "string",
            "minLength": 1
          },
          "kinds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "color": {
                  "default": "gray",
                  "type": "string",
                  "enum": [
                    "red",
                    "blue",
                    "aqua",
                    "orange",
                    "yellow",
                    "magenta",
                    "violet",
                    "green",
                    "gray"
                  ]
                },
                "maxOut": {
                  "description": "信号が ON の間の払い出しがこの枚数以下ならこの種別とみなす。種別が複数ある信号で、最後以外の種別に必須",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          },
          "resetsGames": {
            "default": true,
            "description": "当たったら現在のゲーム数（ハマり）を 0 に戻すか",
            "type": "boolean"
          }
        },
        "required": [
          "pin",
          "kinds"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "signals"
  ],
  "title": "Data Counter machine definition"
}
